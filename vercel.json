{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "includeFiles": "lib/**"
    },
    "api/cron-daily.js": {
      "includeFiles": "lib/**",
      "maxDuration": 60
    },
    "api/auth/send-code.js": {
      "includeFiles": "lib/**"
    },
    "api/jobs/*.js": {
      "includeFiles": "lib/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/cron-daily",
      "schedule": "0 11 * * *"
    }
  ]
}